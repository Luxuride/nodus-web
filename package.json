{
  "name": "nodus-web-assets",
  "private": true,
  "version": "0.1.0",
  "description": "The composer bundles (ProseMirror, emoji picker) and the stylesheet (Tailwind, daisyUI). Built into files the Rust build consumes, so `trunk build` needs no npm.",
  "type": "module",
  "scripts": {
    "build": "node js/build.mjs && node js/css.mjs",
    "css": "node js/css.mjs"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "daisyui": "^5.7.50",
    "emoji-picker-element-data": "^1.8.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.5"
  }
}
